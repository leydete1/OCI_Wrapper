{"operation":"CREATE_PROCEDURE","status":"SUCCESS","executed_ddl":"CREATE OR REPLACE PROCEDURE DATA_MANAGER.LOG_MIGRATION_EVENT (\n  P_MESSAGE IN VARCHAR2,\n  P_LOG_ID OUT NUMBER\n)\nAS\nBEGIN\nINSERT INTO DATA_MANAGER.MIGRATION_LOG (LOG_ID, LOG_MESSAGE) VALUES ((SELECT NVL(MAX(LOG_ID),0)+1 FROM DATA_MANAGER.MIGRATION_LOG), P_MESSAGE) RETURNING LOG_ID INTO P_LOG_ID;\nEND LOG_MIGRATION_EVENT;","execution_time":0.001913}