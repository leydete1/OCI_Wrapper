{"operation":"CREATE_PROCEDURE","status":"TEMPLATE_GENERATED","procedure_name":"LOG_MIGRATION_EVENT","parameter_count":2,"generated_ddl":"CREATE OR REPLACE PROCEDURE HR.LOG_MIGRATION_EVENT (\n  P_MESSAGE IN VARCHAR2,\n  P_LOG_ID OUT NUMBER\n)\nAS\nBEGIN\nINSERT INTO HR.MIGRATION_LOG (LOG_ID, LOG_MESSAGE) VALUES (MIGRATION_LOG_SEQ.NEXTVAL, P_MESSAGE) RETURNING LOG_ID INTO P_LOG_ID;\nEND LOG_MIGRATION_EVENT;"}