{"operation":"CREATE_PROCEDURE","status":"SUCCESS","executed_ddl":"CREATE OR REPLACE PROCEDURE DATA_MANAGER.FX_SEQ_PROC_J (\n  P_MESSAGE IN VARCHAR2,\n  P_LOG_ID OUT NUMBER\n)\nAS\nBEGIN\nINSERT INTO DATA_MANAGER.FX_SEQ_LOG_J (LOG_ID, LOG_MESSAGE) VALUES ((SELECT NVL(MAX(LOG_ID),0)+1 FROM DATA_MANAGER.FX_SEQ_LOG_J), P_MESSAGE) RETURNING LOG_ID INTO P_LOG_ID;\nEND FX_SEQ_PROC_J;","execution_time":0.010956}