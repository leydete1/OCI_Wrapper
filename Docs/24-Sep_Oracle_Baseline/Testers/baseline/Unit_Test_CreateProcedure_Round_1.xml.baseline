INSERT INTO HR.MIGRATION_LOG (LOG_ID, LOG_MESSAGE) VALUES (MIGRATION_LOG_SEQ.NEXTVAL, P_MESSAGE) RETURNING LOG_ID INTO P_LOG_ID;
END LOG_MIGRATION_EVENT;</generated_ddl>
