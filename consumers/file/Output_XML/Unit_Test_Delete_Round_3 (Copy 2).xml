<request version="1.0">
    <external_audit_id>audit_stub_delete_round_3</external_audit_id>
    <session_id>-</session_id>
    <transaction required="1">
        <operation type="DELETE">
            <table_name>OCI_FIELD_TEST</table_name>
            <owner>DATA_MANAGER</owner>
            <where>
                <key><field_name>DATE_COL</field_name><key_value>2026-07-27 00:00:00</key_value></key>
            </where>
        </operation>
    </transaction>
</request>
