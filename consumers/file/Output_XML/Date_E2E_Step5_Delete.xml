<?xml version="1.0" encoding="UTF-8"?>

<!--
========================================================================
 Date_E2E_Step5_Delete.xml
 STEP 5 of the end-to-end date-handling test.

 Deletes the row from Step 1/3, keyed ONLY on DATE_COL. Uses yet
 another different, non-canonical format from Step 3's UPDATE (US-style
 MM/DD/YYYY this time, "08/19/2026") with its own <client_date_format> -
 proving DELETE's WHERE-key date normalization independently from
 UPDATE's, not just reusing the same format both times.

 Per the 2026-07-26 GxP design: the before-image SELECT and the
 AUDIT_TRAIL write both happen BEFORE this DELETE actually executes,
 so the attempt is captured in AUDIT_TRAIL regardless of whether Oracle
 itself allows the DELETE to succeed (DATA_MANAGER may or may not have
 DELETE privilege depending on environment - either outcome is
 informative here).

 Expected result: status_code=0, rows_affected=1 (assuming DELETE
 privilege exists - if not, the audit trail will still show the
 attempt was captured correctly even though the row remains).
========================================================================
-->

<request version="1.0">
    <external_audit_id>audit_stub_date_e2e_delete</external_audit_id>
    <session_id>-</session_id>
    <transaction required="1">
        <operation type="DELETE">
            <table_name>OCI_FIELD_TEST</table_name>
            <owner>DATA_MANAGER</owner>
            <where>
                <key>
                    <field_name>DATE_COL</field_name>
                    <key_value>08/19/2026 14:30:00</key_value>
                    <client_date_format>MM/DD/YYYY HH24:MI:SS</client_date_format>
                </key>
            </where>
        </operation>
    </transaction>
</request>
