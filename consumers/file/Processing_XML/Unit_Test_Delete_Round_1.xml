<?xml version="1.0" encoding="UTF-8"?>

<!--
========================================================================
 Unit_Test_Delete_Round_1.xml
 Single-key DELETE by NUMBER_COL.
 Deletes the row inserted by Unit_Test_Insert_Round_1 (NUMBER_COL=42).
 Watch log for "rows_deleted=1" and the AUDIT_TRAIL row written for
 the attempt BEFORE the actual DELETE executes - see
 audit_trail_insert_delete()'s own doc comment for why that ordering
 matters (DATA_MANAGER likely has no DELETE privilege at all, so the
 realistic expected outcome is: validation passes, the before-image
 and AUDIT_TRAIL write both succeed, then Oracle itself rejects the
 DELETE with ORA-01031 - that is the correct, fully-working result for
 this module, not a bug).
 New request-envelope format per Data_Manager_Request_Definitions.docx.
 No <field_type> at all - Level 2 resolves the real column type via
 metadata_cache, never trusts the client.
========================================================================
-->

<request version="1.0">
    <external_audit_id>audit_stub_delete_round_1</external_audit_id>
    <session_id>-</session_id>
    <transaction required="1">
        <operation type="DELETE">
            <table_name>OCI_FIELD_TEST</table_name>
            <owner>DATA_MANAGER</owner>
            <where>
                <key><field_name>NUMBER_COL</field_name><key_value>200</key_value></key>
            </where>
        </operation>
    </transaction>
</request>
