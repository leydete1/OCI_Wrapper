<?xml version="1.0" encoding="UTF-8"?>

<!--
========================================================================
 Transaction Name ROLLBACK test - 2 INSERTs in one atomic transaction,
 name "Save Booking". The first INSERT is valid; the second has a
 non-numeric value in NUMBER_COL, which will fail validation/execution.

 Expected outcome:
   - Row 801 must NOT be present in OCI_FIELD_TEST after this runs -
     the whole transaction rolls back, including the first INSERT that
     "succeeded" before the second one failed.
   - The response should report the second operation's error, not a
     partial success.
   - metrics_Data_Manager.csv should show one TX_BEGIN, one INSERT row
     (the first, successful one, or possibly a Level 2 validation
     failure for the second depending on where NUMBER_COL is checked),
     and one TX_ROLLBACK - all three sharing the same transaction_id
     and transaction_name="Save Booking" (not "-", not blank).

 Run this, then re-run Request_Test_TransactionName_1.xml separately -
 that one should still succeed independently on a fresh transaction.
========================================================================
-->

<request version="1.0">
    <external_audit_id>audit_stub_txname_rollback</external_audit_id>
    <session_id>-</session_id>
    <transaction required="1" name="Save Booking">
        <operation type="INSERT">
            <table_name>OCI_FIELD_TEST</table_name>
            <owner>DATA_MANAGER</owner>
            <row number="1">
                <field><field_name>NUMBER_COL</field_name><value>801</value></field>
                <field><field_name>VARCHAR2_COL</field_name><value>Rollback test - row 1 (should NOT persist)</value></field>
            </row>
        </operation>
        <operation type="INSERT">
            <table_name>OCI_FIELD_TEST</table_name>
            <owner>DATA_MANAGER</owner>
            <row number="1">
                <field><field_name>NUMBER_COL</field_name><value>not_a_number</value></field>
                <field><field_name>VARCHAR2_COL</field_name><value>Rollback test - row 2 (deliberately invalid)</value></field>
            </row>
        </operation>
    </transaction>
</request>
