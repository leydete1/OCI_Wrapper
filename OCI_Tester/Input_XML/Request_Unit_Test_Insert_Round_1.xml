<?xml version="1.0" encoding="UTF-8"?>

<!--
========================================================================
 Round 1 - Scalar only
 Tests the array bind path with no LOB columns.
 Two rows in one batch - exercises bulk insert.

 Slimmed to field_name/value pairs only - the client has no authority
 over field_type/length/precision/scale/nullable/default, and doesn't
 send them. Level 2 validation resolves the real column metadata itself
 via metadata_cache before executing.
========================================================================
-->

<request version="1.0">
    <external_audit_id>audit_stub_insert_round_1</external_audit_id>
    <session_id>-</session_id>

    <transaction required="1">

        <operation type="INSERT">
            <table_name>OCI_FIELD_TEST</table_name>
            <owner>DATA_MANAGER</owner>

            <row number="1">
                <field><field_name>NUMBER_COL</field_name><value>42</value></field>
                <field><field_name>VARCHAR2_COL</field_name><value>Round 1 scalar test row 1</value></field>
                <field><field_name>DATE_COL</field_name><value>2026-05-20</value></field>
            </row>

            <row number="2">
                <field><field_name>NUMBER_COL</field_name><value>99</value></field>
                <field><field_name>VARCHAR2_COL</field_name><value>Round 1 scalar test row 2</value></field>
                <field><field_name>DATE_COL</field_name><value>2026-05-20</value></field>
            </row>

        </operation>

    </transaction>
</request>
