<?xml version="1.0" encoding="UTF-8"?>

<!--
========================================================================
 Request_Multi_Operation_Test.xml

 Three operations in one atomic transaction:
   1. INSERT a new row (NUMBER_COL=500)
   2. UPDATE that same row
   3. SELECT to verify

 transaction required="1" - if any operation fails, the whole request
 rolls back and none of it is durable, per the transaction design
 (Data_Manager_Request_Definitions.docx, Response Envelope section).
========================================================================
-->

<request version="1.0">
    <external_audit_id>audit_stub_multi_op_test</external_audit_id>
    <session_id>-</session_id>

    <transaction required="1">

        <operation type="INSERT">
            <table_name>OCI_FIELD_TEST</table_name>
            <owner>DATA_MANAGER</owner>
            <row number="1">
                <field><field_name>NUMBER_COL</field_name><value>500</value></field>
                <field><field_name>VARCHAR2_COL</field_name><value>Multi-op test row</value></field>
                <field><field_name>DATE_COL</field_name><value>2026-07-16</value></field>
            </row>
        </operation>

        <operation type="UPDATE">
            <table_name>OCI_FIELD_TEST</table_name>
            <owner>DATA_MANAGER</owner>
            <where>
                <key><field_name>NUMBER_COL</field_name><key_value>500</key_value></key>
            </where>
            <set>
                <field><field_name>VARCHAR2_COL</field_name><value>Multi-op test row - updated</value></field>
            </set>
        </operation>

        <operation type="SELECT">
            <sql>
                SELECT NUMBER_COL, VARCHAR2_COL, DATE_COL FROM OCI_FIELD_TEST WHERE NUMBER_COL = 500
            </sql>
        </operation>

    </transaction>
</request>
