<?xml version="1.0" encoding="UTF-8"?>

<!--
========================================================================
 Request_OCI_Test_Create_Session.xml

 Session Manager - Create Session stub request, in the new envelope
 format. session_id is "-" at the envelope level since this request's
 whole purpose is to establish one - a real client wouldn't have a
 session_id yet either at this point. Every field inside the operation
 is a stub value for local testing; a real client integration would
 populate client_id/client_ip/client_host from the actual caller once
 the HTTP input module exists.

 requested_ttl_seconds is optional - omit it (or set to 0) to use
 session_default_ttl_seconds from config.ini.
========================================================================
-->

<request version="1.0">
    <external_audit_id>audit_stub_create_session</external_audit_id>
    <session_id>-</session_id>

    <transaction required="1">

        <operation type="CREATE_SESSION">
            <client_id>stub_client_001</client_id>
            <client_ip>127.0.0.1</client_ip>
            <client_host>localhost</client_host>
            <application_name>Data_Manager_Test_Runner</application_name>

            <requested_ttl_seconds>1800</requested_ttl_seconds>
        </operation>

    </transaction>
</request>
