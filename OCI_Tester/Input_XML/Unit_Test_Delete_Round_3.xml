<?xml version="1.0" encoding="UTF-8"?>

<!--
========================================================================
 Unit_Test_Delete_Round_3.xml
 DATE key DELETE - exercises the TO_DATE wrapper in build_delete_sql().
 Deletes all rows where DATE_COL matches 2026-05-20.
 Watch log for the generated SQL containing
   TO_DATE(:1,'YYYY-MM-DD HH24:MI:SS')
 and confirm rows_deleted matches what was inserted in Round 1.
========================================================================
-->

<Delete_Template>
    <operation>DELETE</operation>
    <table_name>OCI_FIELD_TEST</table_name>
    <owner>DATA_MANAGER</owner>
    <where>
        <key_field>
            <field_name>DATE_COL</field_name>
            <field_type>DATE</field_type>
            <key_value>2026-05-20 00:00:00</key_value>
        </key_field>
    </where>
</Delete_Template>
