
#ifndef LOGGER_H
#define LOGGER_H

#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <time.h>
#include <stdarg.h>

#define LOG_DEBUG 0
#define LOG_INFO  1
#define LOG_WARN  2
#define LOG_ERROR 3

typedef struct {
    FILE   *file;
    char   *filename;
    double  max_size;      // in bytes
    int     rotation_count;
    int     level;
} logger_t;

/* Initialize logger */
int logger_init(logger_t *logger,
                const char *filename,
                double max_size,
                int rotation_count,
                int level);

/* Write to log */
void logger_write(logger_t *logger,
                  int level,
                  const char *func,
                  int thread_id,
                  const char *fmt, ...);

/* Close logger */
void logger_close(logger_t *logger);

#endif
